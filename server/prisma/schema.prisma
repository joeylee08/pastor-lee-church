generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Add your first model when your project needs persistent data.

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photo {
  id         Int      @id @default(autoincrement())
  url        String
  storageKey String   @unique
  caption    String?
  createdAt  DateTime @default(now())
}

model Sermon {
  id         Int      @id @default(autoincrement())
  title      String
  fileName   String
  storageKey String   @unique
  url        String
  createdAt  DateTime @default(now())
}
